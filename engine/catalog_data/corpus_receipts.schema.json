{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:polytope-laboratory:corpus-receipts:2",
  "title": "Corpus receipts version 2",
  "description": "Successor evidence policy alongside the immutable v1 identity inventory. Accepted evidence is not human review. Only separately maintained trusted attestations bound to the complete receipt digest can qualify a named baseline identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "receipts"],
  "properties": {
    "format": {"const": "polytope-corpus-receipts"},
    "schemaVersion": {"const": 2},
    "receipts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "pins": {
      "type": "object", "additionalProperties": false,
      "required": ["crosswalkSha256", "sourceSha256", "assetSha256", "coordinatesSha256", "topologySha256", "licenseSha256", "importerSha256", "verifierSha256", "policySha256"],
      "properties": {
        "crosswalkSha256": {"$ref": "#/$defs/sha"}, "sourceSha256": {"$ref": "#/$defs/sha"},
        "assetSha256": {"$ref": "#/$defs/nullableSha"}, "coordinatesSha256": {"$ref": "#/$defs/sha"},
        "topologySha256": {"$ref": "#/$defs/sha"}, "licenseSha256": {"$ref": "#/$defs/nullableSha"},
        "importerSha256": {"$ref": "#/$defs/sha"}, "verifierSha256": {"$ref": "#/$defs/sha"}, "policySha256": {"$ref": "#/$defs/sha"}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["status", "reference", "statement"],
      "properties": {"status": {"type": "string"}, "reference": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["geometry", "classification", "chirality", "license", "baselineIdentity"],
      "properties": {
        "geometry": {
          "type": "object", "additionalProperties": false, "required": ["status", "audit"],
          "properties": {"status": {"enum": ["numerical-pass", "numerical-fail"]}, "audit": {"type": "object"}}
        },
        "classification": {"allOf": [{"$ref": "#/$defs/assertion"}, {"properties": {"status": {"enum": ["unresolved", "source-asserted", "evidence-supplied"]}}}]},
        "chirality": {"allOf": [{"$ref": "#/$defs/assertion"}, {"properties": {"status": {"enum": ["unresolved", "achiral", "source-relative-pair", "chiral-unassigned"]}}}]},
        "license": {"allOf": [{"$ref": "#/$defs/assertion"}, {"properties": {"status": {"enum": ["unreviewed", "redistribution-asserted", "restricted"]}}}]},
        "baselineIdentity": {"allOf": [{"$ref": "#/$defs/assertion"}, {"properties": {"status": {"enum": ["unreviewed", "correspondence-asserted"]}}}]}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "identity", "realization", "pins", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "identity": {"$ref": "#/$defs/id"}, "realization": {"$ref": "#/$defs/id"},
        "pins": {"$ref": "#/$defs/pins"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
