{
  "format": "polytope-symmetry-fixtures",
  "version": 1,
  "scope": "All 39 native classical 3D realizations (five Platonic, thirteen Archimedean and thirteen Catalan identities with four additional mirror realizations, four Kepler-Poinsot); all sixteen classical regular 4D sources; selected convex A4/B4/F4 and Goursat H4 Wythoff representatives. No claim for all U75, Johnson, compounds, scaliforms, arbitrary imports or 2191 uniform 4D identities.",
  "references": [
    {
      "title": "Heckman, Coxeter Groups, finite Coxeter group orders",
      "url": "https://www.math.ru.nl/~heckman/CoxeterGroups.pdf",
      "basis": "A3 24, B3 48, H3 120; A4 120, B4 384, F4 1152, H4 14400. Chiral snubs and their duals have the rotation group only. Polar duals preserve the group."
    },
    {
      "title": "Schulte, Regular Polytopes, tables 18.1.1 and 18.2.1",
      "url": "https://www.csun.edu/~ctoth/Handbook/chap18.pdf",
      "basis": "Six convex and ten Schlaefli-Hess regular 4D types; independent flag action crosscheck uses regular4d_validation."
    },
    {
      "title": "Incidence controls",
      "basis": "Removing one icosahedral face leaves its setwise triangle stabilizer of order 6; adding one open five-face tesseract cell leaves order 8. Similarities preserve action permutations; a one-frame cube run cannot exhaust 48 actions."
    }
  ],
